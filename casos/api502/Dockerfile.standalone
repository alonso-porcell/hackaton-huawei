FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    nginx \
    supervisor \
    curl \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

RUN python3 -m pip install --no-cache-dir --break-system-packages \
    fastapi==0.141.1 uvicorn==0.52.4 httpx==0.28.1

RUN corepack enable && corepack prepare pnpm@11.25.0 --activate

WORKDIR /app

COPY incident-tools/package.json incident-tools/pnpm-lock.yaml incident-tools/pnpm-workspace.yaml ./incident-tools/
RUN cd incident-tools && pnpm install --frozen-lockfile

COPY incident-tools/ ./incident-tools/
COPY features/ ./incident-tools/features/
COPY nginx/scenarios/ ./scenarios/
COPY api/ ./api/
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/scenarios/ /etc/nginx/scenarios/

RUN cd incident-tools && pnpm build && cp src/*.html dist/src/ 2>/dev/null || true

RUN mkdir -p /control/requests /control/results /control/snapshots /logs /run/secrets /engram \
    && cp /etc/nginx/scenarios/healthy-upstream.conf /control/active-upstream.conf

RUN echo "sk-w8tTwtiFDLpzXHSoyo7o7Q" > /run/secrets/kostra_api_key

RUN useradd -r -s /bin/false appuser \
    && chown -R appuser:appuser /app /engram /run/secrets

COPY nginx/control-entrypoint.sh /usr/local/bin/api502-nginx
RUN chmod +x /usr/local/bin/api502-nginx

RUN rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /var/lib/nginx /run/nginx \
    && chown -R appuser:appuser /var/lib/nginx /run/nginx

COPY <<'EOF' /etc/supervisor/conf.d/ir-agent.conf
[supervisord]
nodaemon=true
logfile=/logs/supervisord.log
pidfile=/tmp/supervisord.pid

[program:api]
command=python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8000
directory=/app/api
autostart=true
autorestart=true
stdout_logfile=/logs/api.log
stderr_logfile=/logs/api.err

[program:nginx]
command=/usr/local/bin/api502-nginx
autostart=true
autorestart=true
stdout_logfile=/logs/nginx.log
stderr_logfile=/logs/nginx.err

[program:incident-tools]
command=node dist/src/server.js
directory=/app/incident-tools
environment=PORT="3001",BACKEND_URL="http://127.0.0.1:8000/health",PROXY_URL="http://127.0.0.1/gateway-health",CONTROL_DIR="/control",LOG_DIR="/logs",SCENARIO_DIR="/scenarios",KOSTRA_API_KEY_FILE="/run/secrets/kostra_api_key",OPENAI_BASE_URL="https://ai.kostra.cloud/v1",MODEL="glm-5.2",ENGRAM_DIR="/engram"
autostart=true
autorestart=true
stdout_logfile=/logs/incident-tools.log
stderr_logfile=/logs/incident-tools.err
EOF

EXPOSE 3001

HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=10s \
    CMD curl -sf http://127.0.0.1:3001/health || exit 1

USER appuser

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/ir-agent.conf"]
